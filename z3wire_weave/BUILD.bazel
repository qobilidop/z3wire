load("@protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_proto//proto:defs.bzl", "proto_library")

proto_library(
    name = "wire_spec_proto",
    srcs = ["wire_spec.proto"],
)

cc_proto_library(
    name = "wire_spec_cc_proto",
    deps = [":wire_spec_proto"],
)

cc_library(
    name = "resolver",
    srcs = ["resolver.cc"],
    hdrs = ["resolver.h"],
    deps = [
        ":wire_spec_cc_proto",
        "@abseil-cpp//absl/strings:str_format",
    ],
)

cc_test(
    name = "resolver_test",
    srcs = ["resolver_test.cc"],
    deps = [
        ":resolver",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "emit_proto",
    srcs = ["emit_proto.cc"],
    hdrs = ["emit_proto.h"],
    deps = [
        ":resolver",
        "@abseil-cpp//absl/strings",
    ],
)

cc_test(
    name = "emit_proto_test",
    srcs = ["emit_proto_test.cc"],
    deps = [
        ":emit_proto",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "emit_header",
    srcs = ["emit_header.cc"],
    hdrs = ["emit_header.h"],
    deps = [
        ":resolver",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
    ],
)

cc_test(
    name = "emit_header_test",
    srcs = ["emit_header_test.cc"],
    deps = [
        ":emit_header",
        ":resolver",
        ":wire_spec_cc_proto",
        "@googletest//:gtest_main",
    ],
)

cc_binary(
    name = "weave",
    srcs = ["weave_main.cc"],
    visibility = ["//visibility:public"],
    deps = [
        ":emit_header",
        ":emit_proto",
        ":resolver",
        ":wire_spec_cc_proto",
        "@protobuf",
    ],
)
