# C++20 for concepts, constexpr improvements, etc.
build --cxxopt=-std=c++20

# Disk cache for faster rebuilds (especially Z3).
build --disk_cache=/workspace/.bazel-disk-cache

# Use LLVM tools for coverage (required when CC=clang).
coverage --repo_env=BAZEL_USE_LLVM_NATIVE_COVERAGE=1
coverage --repo_env=GCOV=llvm-profdata
coverage --experimental_generate_llvm_lcov
